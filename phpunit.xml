<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    bootstrap="vendor/autoload.php"
    cacheDirectory=".phpunit.cache"
    colors="true"
>
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_TIMEZONE" value="UTC" force="true"/>
        <env name="DB_HOST" value="database" force="true"/>
        <env name="DB_PORT" value="3306" force="true"/>
        <env name="DB_NAME" value="example_database" force="true"/>
        <env name="DB_USER" value="example_database_user" force="true"/>
        <env name="DB_PASSWORD" value="example_database_password" force="true"/>
    </php>
</phpunit>
