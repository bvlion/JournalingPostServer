<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    bootstrap="vendor/autoload.php"
    cacheDirectory=".phpunit.cache"
    colors="true"
>
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="DB_HOST" value="database" force="true"/>
        <env name="DB_PORT" value="3306" force="true"/>
        <env name="DB_NAME" value="journalingpost_docker_local" force="true"/>
        <env name="DB_USER" value="journalingpost_docker_local" force="true"/>
        <env name="DB_PASSWORD" value="journalingpost_docker_local_password" force="true"/>
        <env name="ANALYSIS_FINGERPRINT_SECRET" value="example_fingerprint_secret_not_for_production_use" force="true"/>
        <env name="OPENAI_API_KEY" value="sk-example-not-a-real-openai-key" force="true"/>
        <env name="OPENAI_TIMEOUT_SECONDS" value="45" force="true"/>
    </php>
</phpunit>
